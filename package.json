{
  "name": "riyad-alquran-rewards",
  "version": "1.0.0",
  "private": true,
  "description": "منصة تحفيزية لمجمع رياض القرآن التعليمي: شيكات النقاط، فارس الأسبوع، حلقة الأسبوع، الصدارة، المتجر ومسح الباركود",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "comment_engines": "على إصدارات Node الأقدم ثبّت better-sqlite3 وسيُستخدم تلقائياً",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "icons": "python3 scripts/make_icons.py",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msnd7/t-aog.git"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.2",
    "jsbarcode": "^3.12.1",
    "multer": "^1.4.4"
  },
  "optionalDependencies": {
    "libsql": "^0.5.29"
  },
  "comment_optional": "libsql تُستخدم فقط عند ضبط TURSO_DATABASE_URL (استضافات بلا قرص دائم مثل Vercel)"
}
